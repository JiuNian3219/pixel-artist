# 站点 URL（用于 SEO 和生成 sitemap，不带末尾斜杠）
VITE_SITE_URL=https://pixel-artist.xyz

# Umami 分析 ID（可选，不填则不启用分析）
VITE_UMAMI_WEBSITE_ID=your-website-id
VITE_UMAMI_SCRIPT_URL=https://your-umami-domain.com/script.js

# 爬虫控制 (可选，默认为 /)
VITE_ROBOTS_ALLOW=/

# Bing Webmaster 验证 (可选)
BING_SITE_AUTH_USER=your-bing-auth-code

